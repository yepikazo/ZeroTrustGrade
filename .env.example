# ── Port & alamat ─────────────────────────────────────────────
HOST=127.0.0.1
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# ── Database (satu file untuk gateway + kedua service) ────────
DB_PATH=data/app.sqlite

# ── JWT ───────────────────────────────────────────────────────
# Ganti dengan nilai acak di lingkungan nyata:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=ganti-dengan-random-32-byte-access-token
JWT_SERVICE_SECRET=ganti-dengan-random-32-byte-service-token
JWT_ISSUER=zerotrustgrade
ACCESS_TOKEN_TTL=600
SERVICE_TOKEN_TTL=300
REFRESH_TOKEN_TTL=86400

# ── Gateway secret & client service ───────────────────────────
GATEWAY_SECRET=ganti-dengan-random-32-byte-gateway-secret
SERVICE_CLIENT_ID=nilai-service
SERVICE_CLIENT_SECRET=svc-nilai-secret-2026

# ── Jam akses (hanya untuk ubah & finalisasi nilai) ───────────
ACCESS_WINDOW_ENABLED=true
ACCESS_START=07:00
ACCESS_END=21:00
APP_TZ=Asia/Jakarta
